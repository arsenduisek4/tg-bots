# Telegram Bot Token (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=ваш_токен_бота

# Groq API Key (получить на console.groq.com/keys)
GROQ_API_KEY=ваш_groq_api_key

# Модель Groq (по умолчанию llama3-70b-8192 — быстрая и умная)
GROQ_MODEL=llama3-70b-8192

# Системный промпт (как бот себя ведёт)
SYSTEM_PROMPT=Ты — полезный AI-ассистент. Отвечай кратко и по делу на русском языке.
